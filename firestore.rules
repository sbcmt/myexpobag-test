rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(id) { return signedIn() && request.auth.uid == id; }
    function validSlug(slug) { return slug is string && slug.size() >= 1 && slug.size() <= 48 && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$'); }
    function validDisplayName(name) { return name is string && name.size() >= 1 && name.size() <= 100; }
    // Tiny PNG/WebP/JPEG data URI only. No SVG, external URL or unlimited payload.
    function validEventName(name) { return name is string && name.size() <= 80; }
    function validLogo(icon) { return icon is string && icon.size() <= 70000 && (icon == '' || icon.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/]+={0,2}$')); }

    // One brand per newly registered account for v1.0.1. The document ID is the
    // authenticated owner's UID; no client-supplied brand ownership is trusted.
    match /brands/{brandId} {
      allow get: if owner(brandId);
      allow list: if false;
      allow create: if owner(brandId)
        && request.resource.data.keys().hasOnly(['ownerUid','slug','registrationName','displayName','logoUrl','operatorName','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['ownerUid','slug','registrationName','displayName','logoUrl','operatorName','createdAt','updatedAt'])
        && request.resource.data.ownerUid == brandId
        && validSlug(request.resource.data.slug)
        && validDisplayName(request.resource.data.displayName)
        && validDisplayName(request.resource.data.registrationName)
        && request.resource.data.logoUrl == ''
        && request.resource.data.operatorName is string && request.resource.data.operatorName.size() >= 1 && request.resource.data.operatorName.size() <= 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/brandHandles/$(request.resource.data.slug)).data.brandId == brandId;
      // A later brand-settings.html may change ONLY display name and logo.
      allow update: if owner(brandId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','logoUrl','operatorName','updatedAt'])
        && validDisplayName(request.resource.data.displayName)
        && validLogo(request.resource.data.logoUrl)
        && (!('operatorName' in request.resource.data) || (request.resource.data.operatorName is string && request.resource.data.operatorName.size() >= 1 && request.resource.data.operatorName.size() <= 120))
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/brandHandles/$(resource.data.slug)).data.displayName == request.resource.data.displayName
        && getAfter(/databases/$(database)/documents/brandHandles/$(resource.data.slug)).data.logoUrl == request.resource.data.logoUrl
        && getAfter(/databases/$(database)/documents/brandHandles/$(resource.data.slug)).data.get('operatorName','') == request.resource.data.get('operatorName','');
      allow delete: if false;
    }

    // Private draft inventory for the authenticated brand owner only.
    // Never expose draft catalog or SKU data to a visitor until publishing is implemented.
    match /brands/{brandId}/products/{productId} {
      function validCombination(entry) {
        return entry is map
          && entry.keys().hasOnly(['productId','discount'])
          && entry.keys().hasAll(['productId','discount'])
          && entry.productId is string
          && entry.productId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$')
          && entry.productId != productId
          && entry.discount is int
          && entry.discount >= 0 && entry.discount <= 100000000;
      }
      function validCombinations() {
        return !('combos' in request.resource.data) || (
          request.resource.data.combos is list
          && request.resource.data.combos.size() <= 3
          && (request.resource.data.combos.size() < 1 || validCombination(request.resource.data.combos[0]))
          && (request.resource.data.combos.size() < 2 || validCombination(request.resource.data.combos[1]))
          && (request.resource.data.combos.size() < 3 || validCombination(request.resource.data.combos[2]))
          && (request.resource.data.combos.size() == 0 || (request.resource.data.comboProductId == request.resource.data.combos[0].productId && request.resource.data.comboDiscount == request.resource.data.combos[0].discount))
          && (request.resource.data.combos.size() > 0 || (request.resource.data.comboProductId == '' && request.resource.data.comboDiscount == 0))
          && (request.resource.data.combos.size() < 2 || request.resource.data.combos[0].productId != request.resource.data.combos[1].productId)
          && (request.resource.data.combos.size() < 3 || (request.resource.data.combos[0].productId != request.resource.data.combos[2].productId && request.resource.data.combos[1].productId != request.resource.data.combos[2].productId))
        );
      }
      function validProduct() {
        return productId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$')
          && request.resource.data.keys().hasOnly(['id','name','categoryName','price','eventPrice','variants','active','janCode','preorder','stock','comboProductId','comboDiscount','combos','releaseMonth','releasePeriod','createdAt','updatedAt','noveltyTarget'])
          && request.resource.data.keys().hasAll(['id','name','categoryName','price','eventPrice','variants','active','janCode','preorder','stock','comboProductId','comboDiscount','createdAt','updatedAt'])
          && request.resource.data.id == productId
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 100
          && request.resource.data.categoryName is string && request.resource.data.categoryName.size() >= 1 && request.resource.data.categoryName.size() <= 40
          && request.resource.data.price is int && request.resource.data.price >= 0 && request.resource.data.price <= 100000000
          && (request.resource.data.eventPrice == null || (request.resource.data.eventPrice is int && request.resource.data.eventPrice >= 0 && request.resource.data.eventPrice < request.resource.data.price))
          && request.resource.data.variants is list && request.resource.data.variants.size() <= 100
          && request.resource.data.janCode is string && request.resource.data.janCode.size() <= 14
          && request.resource.data.preorder is bool
          // A regular product may contain individually preordered variants.
          // Such a product legitimately has releaseMonth/releasePeriod even when preorder=false.
          // Accept either no release date or a fully valid release date, while requiring
          // the date whenever the entire product is marked as preorder.
          && (
            ((!('releaseMonth' in request.resource.data) || request.resource.data.releaseMonth == null)
              && (!('releasePeriod' in request.resource.data) || request.resource.data.releasePeriod == '')
              && request.resource.data.preorder == false)
            || (request.resource.data.releaseMonth is int
              && request.resource.data.releaseMonth >= 1 && request.resource.data.releaseMonth <= 12
              && request.resource.data.releasePeriod in ['上旬','中旬','下旬'])
          )
          && (request.resource.data.stock == null || (request.resource.data.stock is int && request.resource.data.stock >= 0 && request.resource.data.stock <= 100000000))
          && request.resource.data.comboProductId is string && request.resource.data.comboProductId.size() <= 40
          && request.resource.data.comboDiscount is int && request.resource.data.comboDiscount >= 0 && request.resource.data.comboDiscount <= 100000000
          && validCombinations()
          && request.resource.data.active is bool
          && (!('noveltyTarget' in request.resource.data) || request.resource.data.noveltyTarget is bool)
          && request.resource.data.updatedAt == request.time;
      }
      allow get, list: if owner(brandId);
      allow create: if owner(brandId) && validProduct()
        && request.resource.data.createdAt == request.time;
      allow update: if owner(brandId) && validProduct()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owner(brandId);
    }
    // Owner-only product photos, separately stored so listing prices never fetches images.
    // Client compresses originals before saving. 109.2k base64 chars <= 80KiB photo.
    match /brands/{brandId}/productImages/{productId} {
      function validProductImage() {
        return productId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$')
          && request.resource.data.keys().hasOnly(['productId','imageData','updatedAt'])
          && request.resource.data.keys().hasAll(['productId','imageData','updatedAt'])
          && request.resource.data.productId == productId
          && request.resource.data.imageData is string
          && request.resource.data.imageData.size() <= 109200
          && request.resource.data.imageData.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/]+={0,2}$')
          && request.resource.data.updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/brands/$(brandId)/products/$(productId));
      }
      allow get: if owner(brandId);
      allow list: if false;
      allow create, update: if owner(brandId) && validProductImage();
      allow delete: if owner(brandId);
    }

    match /brands/{brandId}/catalogSettings/{settingsId} {
      allow get: if owner(brandId) && settingsId == 'main';
      allow list: if false;
      allow create, update: if owner(brandId) && settingsId == 'main'
        && request.resource.data.keys().hasOnly(['categories','updatedAt'])
        && request.resource.data.keys().hasAll(['categories','updatedAt'])
        && request.resource.data.categories is list && request.resource.data.categories.size() <= 80
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Public lookup has only brand ID/slug. Never put private email/customer
    // fields here. Actual published product details will need separate rules.
    match /brandHandles/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && validSlug(slug)
        && request.resource.data.keys().hasOnly(['brandId','ownerUid','slug','displayName','logoUrl','operatorName'])
        && request.resource.data.keys().hasAll(['brandId','ownerUid','slug','displayName','logoUrl','operatorName'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.brandId == request.auth.uid
        && request.resource.data.slug == slug
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.logoUrl == ''
        && request.resource.data.operatorName is string && request.resource.data.operatorName.size() >= 1 && request.resource.data.operatorName.size() <= 120
        && request.resource.data.operatorName == getAfter(/databases/$(database)/documents/brands/$(request.auth.uid)).data.operatorName
        && request.resource.data.displayName == getAfter(/databases/$(database)/documents/brands/$(request.auth.uid)).data.displayName
        && getAfter(/databases/$(database)/documents/brands/$(request.auth.uid)).data.slug == slug;
      // Only the matching owner may mirror their private display name and logo.
      // A visitor cannot change a brand-to-owner mapping via a forged URL.
      allow update: if signedIn()
        && resource.data.brandId == request.auth.uid
        && resource.data.ownerUid == request.auth.uid
        && resource.data.slug == slug
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','logoUrl','eventName','operatorName'])
        && request.resource.data.keys().hasAll(['brandId','ownerUid','slug','displayName','logoUrl'])
        && request.resource.data.keys().hasOnly(['brandId','ownerUid','slug','displayName','logoUrl','eventName','operatorName'])
        && (!('eventName' in request.resource.data) || validEventName(request.resource.data.eventName))
        && validDisplayName(request.resource.data.displayName)
        && validLogo(request.resource.data.logoUrl)
        && getAfter(/databases/$(database)/documents/brands/$(request.auth.uid)).data.slug == slug
        && getAfter(/databases/$(database)/documents/brands/$(request.auth.uid)).data.displayName == request.resource.data.displayName
        && getAfter(/databases/$(database)/documents/brands/$(request.auth.uid)).data.logoUrl == request.resource.data.logoUrl
        && (!('operatorName' in request.resource.data) || (request.resource.data.operatorName is string && request.resource.data.operatorName.size() >= 1 && request.resource.data.operatorName.size() <= 120))
        && request.resource.data.get('operatorName','') == getAfter(/databases/$(database)/documents/brands/$(request.auth.uid)).data.get('operatorName','');
      allow delete: if false;
    }

    // Public presentation and promotion settings. No personal information.
    // The banner is a capped, compressed image data URL stored separately from
    // catalog and stock, so promotion edits do not overwrite live inventory.
    // Brand owner may replace public presentation settings. Validate data shape,
    // fixed size limits, link protocol, and ownership without imposing fragile
    // cross-field rules that can reject otherwise legitimate setting edits.
    // Settings owner check is tied to the immutable public brand handle.
    // Validate the document shape and cap the banner size. Field relationships
    // and form-specific values are validated client-side by settings.js.
    match /brandSettings/{slug} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && exists(/databases/$(database)/documents/brandHandles/$(slug))
        && get(/databases/$(database)/documents/brandHandles/$(slug)).data.brandId == request.auth.uid
        && get(/databases/$(database)/documents/brandHandles/$(slug)).data.slug == slug
        && exists(/databases/$(database)/documents/brands/$(request.auth.uid))
        && get(/databases/$(database)/documents/brands/$(request.auth.uid)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/brands/$(request.auth.uid)).data.slug == slug
        && request.resource.data.keys().hasOnly(['brandId','slug','theme','banner','discount','novelty','shipping','checkout','updatedAt'])
        && request.resource.data.keys().hasAll(['brandId','slug','theme','banner','discount','novelty','shipping','updatedAt'])
        && request.resource.data.brandId == request.auth.uid
        && request.resource.data.slug == slug
        && request.resource.data.updatedAt == request.time
        && request.resource.data.theme is map
        && request.resource.data.banner is map
        && request.resource.data.discount is map
        && request.resource.data.novelty is map
        && request.resource.data.theme.keys().hasOnly(['preset'])
        && request.resource.data.banner.keys().hasOnly(['enabled','hiddenDefault','imageData','linkMode','linkValue'])
        && request.resource.data.discount.keys().hasOnly(['mode','value','minSpend','applyToPreorder'])
        && (!('applyToPreorder' in request.resource.data.discount) || request.resource.data.discount.applyToPreorder is bool)
        && (!('checkout' in request.resource.data) || (request.resource.data.checkout is map
          && request.resource.data.checkout.keys().hasOnly(['handoffExpiryMinutes'])
          && request.resource.data.checkout.keys().hasAll(['handoffExpiryMinutes'])
          && request.resource.data.checkout.handoffExpiryMinutes in [1,3,5,10]))
        && request.resource.data.novelty.keys().hasOnly(['mode','name','minSpend','productId','productIds'])
        && (!('productIds' in request.resource.data.novelty) || (request.resource.data.novelty.productIds is list && request.resource.data.novelty.productIds.size() <= 300))
        && (request.resource.data.shipping is map && request.resource.data.shipping.keys().hasAll(['mode','threshold','charge','rates']) && request.resource.data.shipping.keys().hasOnly(['mode','threshold','charge','rates']) && request.resource.data.shipping.mode in ['all','threshold','prefecture'] && request.resource.data.shipping.threshold is int && request.resource.data.shipping.threshold >= 0 && request.resource.data.shipping.threshold <= 100000000 && request.resource.data.shipping.charge is int && request.resource.data.shipping.charge >= 0 && request.resource.data.shipping.charge <= 100000 && request.resource.data.shipping.rates is map && request.resource.data.shipping.rates.keys().size() <= 47)
        && request.resource.data.banner.imageData is string
        && request.resource.data.banner.imageData.size() <= 210000;
      allow delete: if false;
    }

    // Public, sanitized inventory snapshot. Only the signed-in owner of the
    // exact slug may publish. A visitor can get one brand, never list all brands.
    function publishingOwner(slug) {
      return signedIn()
        && exists(/databases/$(database)/documents/brands/$(request.auth.uid))
        && get(/databases/$(database)/documents/brands/$(request.auth.uid)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/brands/$(request.auth.uid)).data.slug == slug;
    }
    function validCatalog(slug) {
      return publishingOwner(slug)
        && request.resource.data.keys().hasOnly(['brandId','slug','products','categories','bundles','publishedImageIds','updatedAt'])
        && request.resource.data.keys().hasAll(['brandId','slug','products','categories','bundles','publishedImageIds','updatedAt'])
        && request.resource.data.brandId == request.auth.uid
        && request.resource.data.slug == slug
        && request.resource.data.products is list && request.resource.data.products.size() <= 300
        && request.resource.data.categories is list && request.resource.data.categories.size() <= 80
        && request.resource.data.bundles is list && request.resource.data.bundles.size() <= 900
        && request.resource.data.publishedImageIds is list && request.resource.data.publishedImageIds.size() <= 300
        && request.resource.data.updatedAt == request.time;
    }
    match /publishedCatalogs/{slug} {
      allow get: if true;
      allow list: if false;
      allow create, update: if validCatalog(slug);
      allow delete: if false;
    }
    // Separate photo docs avoid loading every photo with the catalog and
    // never expose images of unpublished (hidden/deleted) products.
    match /publishedCatalogs/{slug}/images/{productId} {
      allow get: if exists(/databases/$(database)/documents/publishedCatalogs/$(slug))
        && productId in get(/databases/$(database)/documents/publishedCatalogs/$(slug)).data.publishedImageIds;
      allow list: if false;
      allow create, update: if publishingOwner(slug)
        && productId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$')
        && request.resource.data.keys().hasOnly(['productId','imageData','updatedAt'])
        && request.resource.data.keys().hasAll(['productId','imageData','updatedAt'])
        && request.resource.data.productId == productId
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 109200
        && request.resource.data.imageData.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/]+={0,2}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if publishingOwner(slug);
    }

    // Lightweight public inventory shared by all customers: ONE listener per brand.
    // The signed-in brand owner may publish and atomically change quantities.
    match /publishedStock/{slug} {
      allow get: if true;
      allow list: if false;
      allow create, update: if publishingOwner(slug)
        && request.resource.data.keys().hasOnly(['slug','brandId','quantities','variantQuantities','updatedAt'])
        && request.resource.data.keys().hasAll(['slug','brandId','quantities','updatedAt'])
        && request.resource.data.slug == slug
        && request.resource.data.brandId == request.auth.uid
        && request.resource.data.quantities is map
        && request.resource.data.quantities.size() <= 300
        && (!('variantQuantities' in request.resource.data) || (request.resource.data.variantQuantities is map && request.resource.data.variantQuantities.size() <= 10000))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Owner-only reservation ledger. Immutable original order + pricing snapshot.
    // Mutable remaining lines are updated atomically with stock changes.
    match /brands/{brandId}/scannedOrders/{orderId} {
      function validOrder() {
        return request.resource.data.keys().hasOnly(['orderId','brandId','originalItems','originalAmount','originalLines','remainingLines','bundles','items','amount','status','scanTime','updatedAt','discountMode','discountValue','discountMinSpend','discountRegistered','discountApplyToPreorder','noveltyMode','noveltyName','noveltyMinSpend','noveltyProductId','noveltyProductIds','shippingFee','shippingMode','shippingThreshold','shippingCharge','shippingPrefecture','hasPreorder','hasCustomerData'])
          && request.resource.data.keys().hasAll(['orderId','brandId','originalItems','originalAmount','originalLines','remainingLines','bundles','items','amount','status','scanTime','updatedAt'])
          && request.resource.data.orderId == orderId
          && (!('discountMode' in request.resource.data) || request.resource.data.discountMode in ['none','percent','amount'])
          && (!('discountValue' in request.resource.data) || (request.resource.data.discountValue is int && request.resource.data.discountValue >= 0 && request.resource.data.discountValue <= 100000000))
          && (!('discountRegistered' in request.resource.data) || request.resource.data.discountRegistered is bool)
          && (!('discountApplyToPreorder' in request.resource.data) || request.resource.data.discountApplyToPreorder is bool)
          && (!('discountMinSpend' in request.resource.data) || (request.resource.data.discountMinSpend is int && request.resource.data.discountMinSpend >= 0 && request.resource.data.discountMinSpend <= 100000000))
          && (!('noveltyMode' in request.resource.data) || request.resource.data.noveltyMode in ['none','all','minimum','product'])
          && (!('noveltyName' in request.resource.data) || (request.resource.data.noveltyName is string && request.resource.data.noveltyName.size() <= 100))
          && (!('noveltyMinSpend' in request.resource.data) || (request.resource.data.noveltyMinSpend is int && request.resource.data.noveltyMinSpend >= 0 && request.resource.data.noveltyMinSpend <= 100000000))
          && (!('noveltyProductId' in request.resource.data) || (request.resource.data.noveltyProductId is string && request.resource.data.noveltyProductId.size() <= 40))
          && (!('noveltyProductIds' in request.resource.data) || (request.resource.data.noveltyProductIds is list && request.resource.data.noveltyProductIds.size() <= 300))
          && (!('shippingFee' in request.resource.data) || (request.resource.data.shippingFee is int && request.resource.data.shippingFee >= 0 && request.resource.data.shippingFee <= 100000))
          && (!('shippingMode' in request.resource.data) || request.resource.data.shippingMode in ['all','threshold','prefecture'])
          && (!('shippingThreshold' in request.resource.data) || (request.resource.data.shippingThreshold is int && request.resource.data.shippingThreshold >= 0 && request.resource.data.shippingThreshold <= 100000000))
          && (!('shippingCharge' in request.resource.data) || (request.resource.data.shippingCharge is int && request.resource.data.shippingCharge >= 0 && request.resource.data.shippingCharge <= 100000))
          && (!('shippingPrefecture' in request.resource.data) || (request.resource.data.shippingPrefecture is string && request.resource.data.shippingPrefecture.size() <= 8))
          && (!('hasPreorder' in request.resource.data) || request.resource.data.hasPreorder is bool)
          && (!('hasCustomerData' in request.resource.data) || request.resource.data.hasCustomerData is bool)
          && request.resource.data.brandId == brandId
          && request.resource.data.originalItems is list && request.resource.data.originalItems.size() >= 1 && request.resource.data.originalItems.size() <= 30
          && request.resource.data.originalLines is list && request.resource.data.originalLines.size() >= 1 && request.resource.data.originalLines.size() <= 30
          && request.resource.data.remainingLines is list && request.resource.data.remainingLines.size() <= 30
          && request.resource.data.bundles is list && request.resource.data.bundles.size() <= 900
          && request.resource.data.items is list && request.resource.data.items.size() <= 30
          && request.resource.data.originalAmount is int && request.resource.data.originalAmount >= 0 && request.resource.data.originalAmount <= 100000000
          && request.resource.data.amount is int && request.resource.data.amount >= 0 && request.resource.data.amount <= 100000000
          && request.resource.data.status in ['reserved','cancelled','handedOff']
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if owner(brandId);
      allow list: if owner(brandId);
      allow create: if owner(brandId)
        && orderId.matches('^(MEB|DEMO)-[A-F0-9]{20}$')
        && validOrder()
        && request.resource.data.status == 'reserved'
        && request.resource.data.amount == request.resource.data.originalAmount
        && request.resource.data.scanTime == request.time;
      allow update: if owner(brandId)
        && validOrder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingLines','items','amount','shippingFee','status','updatedAt'])
        && resource.data.status == 'reserved'
        && ((request.resource.data.status == 'cancelled' && request.resource.data.items.size() == 0 && request.resource.data.amount == 0)
            || request.resource.data.status in ['reserved','handedOff']);
      // A full cancellation must atomically mark the public QR as cancelled.
      // Finished sales may still be removed by the existing password-confirmed history tool.
      allow delete: if owner(brandId) && (
        resource.data.status in ['handedOff','cancelled'] ||
        (resource.data.status == 'reserved'
          && existsAfter(/databases/$(database)/documents/publicOrderConfirmations/$(get(/databases/$(database)/documents/brands/$(brandId)).data.slug)/orders/$(orderId))
          && getAfter(/databases/$(database)/documents/publicOrderConfirmations/$(get(/databases/$(database)/documents/brands/$(brandId)).data.slug)/orders/$(orderId)).data.status == 'cancelled'
          && getAfter(/databases/$(database)/documents/publicOrderConfirmations/$(get(/databases/$(database)/documents/brands/$(brandId)).data.slug)/orders/$(orderId)).data.amount == 0));
    }

    // Public acknowledgement: only the person holding the unpredictable QR
    // order ID can fetch status/amount; no name or email is published.
    match /publicOrderConfirmations/{slug}/orders/{orderId} {
      function ackValid() {
        return publishingOwner(slug)
          && orderId.matches('^(MEB|DEMO)-[A-F0-9]{20}$')
          && request.resource.data.keys().hasOnly(['slug','brandId','orderId','status','confirmedAt','amount','modified','hasPreorder','updatedAt','handedOffAt','expiresInMinutes'])
          && request.resource.data.keys().hasAll(['slug','brandId','orderId','status','confirmedAt','amount','modified','hasPreorder','updatedAt'])
          && request.resource.data.slug == slug
          && request.resource.data.brandId == request.auth.uid
          && request.resource.data.orderId == orderId
          && request.resource.data.status in ['confirmed','cancelled','handedOff']
          // Only an actual handoff may set the handoff timestamp and QR expiry.
          && (request.resource.data.status == 'handedOff'
              ? ('handedOffAt' in request.resource.data
                 && 'expiresInMinutes' in request.resource.data
                 && request.resource.data.handedOffAt == request.time
                 && request.resource.data.expiresInMinutes in [1,3,5,10])
              : (!('handedOffAt' in request.resource.data)
                 && !('expiresInMinutes' in request.resource.data)))
          && request.resource.data.amount is int && request.resource.data.amount >= 0 && request.resource.data.amount <= 100000000
          && request.resource.data.modified is bool
          && request.resource.data.hasPreorder is bool
          && request.resource.data.updatedAt == request.time
          && (
            (existsAfter(/databases/$(database)/documents/brands/$(request.auth.uid)/scannedOrders/$(orderId))
              && getAfter(/databases/$(database)/documents/brands/$(request.auth.uid)/scannedOrders/$(orderId)).data.amount == request.resource.data.amount)
            || (request.resource.data.status == 'cancelled'
              && request.resource.data.amount == 0
              && exists(/databases/$(database)/documents/brands/$(request.auth.uid)/scannedOrders/$(orderId))
              && get(/databases/$(database)/documents/brands/$(request.auth.uid)/scannedOrders/$(orderId)).data.status == 'reserved'
              && !existsAfter(/databases/$(database)/documents/brands/$(request.auth.uid)/scannedOrders/$(orderId))));
      }
      allow get: if true;
      allow list: if false;
      allow create: if ackValid()
        && request.resource.data.status == 'confirmed'
        && request.resource.data.modified == false
        && request.resource.data.confirmedAt == request.time;
      allow update: if ackValid()
        && resource.data.status == 'confirmed'
        && request.resource.data.confirmedAt == resource.data.confirmedAt
        && request.resource.data.modified == true
        && (
          // Completing an order requires the matching private sale to be
          // marked handedOff in the same transaction.
          (request.resource.data.status == 'handedOff'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','amount','modified','hasPreorder','handedOffAt','expiresInMinutes','updatedAt'])
            && existsAfter(/databases/$(database)/documents/brands/$(request.auth.uid)/scannedOrders/$(orderId))
            && getAfter(/databases/$(database)/documents/brands/$(request.auth.uid)/scannedOrders/$(orderId)).data.status == 'handedOff')
          ||
          // Keep existing partial/full cancellation permissions unchanged.
          (request.resource.data.status in ['confirmed','cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','amount','modified','hasPreorder','updatedAt']))
        );
      allow delete: if false;
    }

    // Personal data only exists in brand-private orders, never public catalog or QR.
    // Checkout creates an empty shipping placeholder for preorder; buyer fills it only
    // AFTER owner reservation has created a confirmed public acknowledgement.
    match /customerOrders/{slug}/orders/{orderId} {
      function brandOwner() {
        return signedIn() && exists(/databases/$(database)/documents/brandHandles/$(slug))
          && get(/databases/$(database)/documents/brandHandles/$(slug)).data.brandId == request.auth.uid;
      }
      function validShipping(ship) {
        return ship is map
          && ship.keys().hasAll(['prefecture','postal','address','name','phone','email'])
          && ship.keys().hasOnly(['prefecture','postal','address','name','phone','email'])
          && ship.prefecture is string && ship.prefecture.size() <= 8
          && ship.postal is string && ship.postal.size() <= 7
          && ship.address is string && ship.address.size() <= 200
          && ship.name is string && ship.name.size() <= 80
          && ship.phone is string && ship.phone.size() <= 11
          && ship.email is string && ship.email.size() <= 200
          && (ship.postal == '' || ship.postal.matches('^[0-9]{7}$'))
          && (ship.phone == '' || ship.phone.matches('^[0-9]{10,11}$'));
      }
      function validCustomerOrder() {
        return signedIn() && validSlug(slug)
          && orderId.matches('^(MEB|DEMO)-[A-F0-9]{20}$')
          && exists(/databases/$(database)/documents/brandHandles/$(slug))
          // Never recreate personal information for a completed/cancelled QR.
          && !exists(/databases/$(database)/documents/publicOrderConfirmations/$(slug)/orders/$(orderId))
          && request.resource.data.keys().hasOnly(['slug','brandId','orderId','registered','buyerName','buyerEmail','marketingConsent','hasPreorder','shipping','deliverySubmitted','creatorUid','createdAt'])
          && request.resource.data.keys().hasAll(['slug','brandId','orderId','registered','buyerName','buyerEmail','marketingConsent','hasPreorder','shipping','deliverySubmitted','creatorUid','createdAt'])
          && request.resource.data.slug == slug && request.resource.data.orderId == orderId
          && request.resource.data.brandId == get(/databases/$(database)/documents/brandHandles/$(slug)).data.brandId
          && request.resource.data.creatorUid == request.auth.uid
          && request.resource.data.registered is bool
          && (request.resource.data.registered || request.resource.data.hasPreorder)
          && request.resource.data.buyerName is string && request.resource.data.buyerName.size() <= 80
          && request.resource.data.buyerEmail is string && request.resource.data.buyerEmail.size() <= 200
          && (request.resource.data.registered
              ? (request.resource.data.buyerName.size() >= 1 && request.resource.data.buyerEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'))
              : (request.resource.data.buyerName == '' && request.resource.data.buyerEmail == '' && request.resource.data.marketingConsent == false))
          && request.resource.data.marketingConsent is bool && request.resource.data.hasPreorder is bool
          && validShipping(request.resource.data.shipping)
          && request.resource.data.shipping.postal == ''
          && request.resource.data.shipping.address == ''
          && request.resource.data.shipping.name == ''
          && request.resource.data.shipping.phone == ''
          && request.resource.data.shipping.email == ''
          && request.resource.data.deliverySubmitted == false
          && request.resource.data.createdAt == request.time;
      }
      allow get: if (signedIn() && resource.data.creatorUid == request.auth.uid) || brandOwner();
      allow list: if brandOwner();
      allow create: if validCustomerOrder();
      // Buyer can fill delivery fields exactly once. Original consent and owner
      // identity are immutable. The order must already be accepted by staff.
      allow update: if signedIn()
        && resource.data.creatorUid == request.auth.uid
        && resource.data.hasPreorder == true
        && resource.data.deliverySubmitted == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shipping','deliverySubmitted','deliverySubmittedAt'])
        && request.resource.data.deliverySubmitted == true
        && request.resource.data.deliverySubmittedAt == request.time
        && validShipping(request.resource.data.shipping)
        && request.resource.data.shipping.prefecture.size() >= 3
        && (resource.data.shipping.prefecture == '' || request.resource.data.shipping.prefecture == resource.data.shipping.prefecture)
        && request.resource.data.shipping.postal.matches('^[0-9]{7}$')
        && request.resource.data.shipping.address.size() >= 5
        && request.resource.data.shipping.address.matches('^' + request.resource.data.shipping.prefecture + '.*')
        && request.resource.data.shipping.name.size() >= 1
        && request.resource.data.shipping.phone.matches('^[0-9]{10,11}$')
        && request.resource.data.shipping.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && exists(/databases/$(database)/documents/publicOrderConfirmations/$(slug)/orders/$(orderId))
        && get(/databases/$(database)/documents/publicOrderConfirmations/$(slug)/orders/$(orderId)).data.status == 'confirmed'
        && get(/databases/$(database)/documents/publicOrderConfirmations/$(slug)/orders/$(orderId)).data.hasPreorder == true;
      allow delete: if brandOwner();
    }

    // Nothing else is made readable/writeable by this first setup.
    match /{document=**} { allow read, write: if false; }
  }
}
